# Copy this file to .env and fill in real values for local development.
# On Render, set these as Environment Variables in the dashboard instead.

# For local dev you can leave this out to use SQLite automatically.
# On Render, use the Postgres connection string Render gives you.
DATABASE_URL=

# Get this from @BotFather (same token your bot already uses)
TELEGRAM_BOT_TOKEN=

MEDIA_ROOT=./media/pdfs
SESSION_TTL_HOURS=720
